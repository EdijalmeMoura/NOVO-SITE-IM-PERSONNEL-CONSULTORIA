# Ambiente e armazenamento
# Em produção, aponte DATA_DIR para um disco persistente. Sem ela, o servidor avisa que usará ./storage.
NODE_ENV=development
PORT=5173
DATA_DIR=./storage
DB_FILE=im-personnel.sqlite
SITE_URL=https://impersonnel.com.br
VITE_SITE_URL=https://impersonnel.com.br

# Contato oficial (opcional; só será exibido quando configurado)
# Número internacional sem +, espaços ou pontuação. Ex.: 5581999999999
VITE_WHATSAPP_NUMBER=
LEADS_NOTIFICATION_EMAIL=

# Administrador inicial sem Shell (ex.: Render). Opcional; ambas as variáveis juntas ou nenhuma.
# Gere o hash localmente com `npm run admin:hash` e marque ADMIN_BOOTSTRAP_PASSWORD_HASH como secreta.
# Nunca coloque a senha em texto puro aqui. Após o primeiro acesso, pode-se remover ou manter as variáveis.
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD_HASH=

# E-mail transacional via SMTP (opcional em desenvolvimento)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=

# Retenção: definir com a pessoa responsável por privacidade antes de produção.
# Em NODE_ENV=production, todos os prazos precisam ser números inteiros positivos (dias).
APPLICATION_RETENTION_DAYS=
TALENT_RETENTION_DAYS=
LEAD_RETENTION_DAYS=
PRIVACY_REQUEST_RETENTION_DAYS=
AUDIT_RETENTION_DAYS=
