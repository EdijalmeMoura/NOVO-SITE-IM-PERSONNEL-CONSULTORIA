# Ambiente e armazenamento
# Em produção, aponte DATA_DIR para um disco persistente. Sem ela, o servidor avisa que usará ./storage.
# DATA_DIR guarda a base SQLite, os currículos em private-resumes/ e as imagens de conteúdo em content-images/.
NODE_ENV=development
PORT=5173
DATA_DIR=./storage
DB_FILE=im-personnel.sqlite
SITE_URL=https://impersonnel.com.br
VITE_SITE_URL=https://impersonnel.com.br

# Contato oficial (opcional; só será exibido quando configurado)
# Número internacional sem +, espaços ou pontuação. Ex.: 5581999999999
VITE_WHATSAPP_NUMBER=
# Caixa da equipe que recebe os avisos de novos contatos, candidaturas e currículos.
# Sem SMTP configurado os formulários continuam gravando no painel, mas nenhum e-mail é enviado.
# Pode ser definida no painel (menu Notificações), que tem prioridade sobre este arquivo.
LEADS_NOTIFICATION_EMAIL=

# Administrador inicial sem Shell (ex.: Render). Opcional; ambas as variáveis juntas ou nenhuma.
# Gere o hash localmente com `npm run admin:hash` e marque ADMIN_BOOTSTRAP_PASSWORD_HASH como secreta.
# Nunca coloque a senha em texto puro aqui. Após o primeiro acesso, pode-se remover ou manter as variáveis.
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD_HASH=

# E-mail transacional via SMTP (opcional em desenvolvimento).
# Tudo abaixo pode ser configurado no painel, em Painel › Notificações: o valor salvo lá é
# gravado na base SQLite e tem prioridade sobre estas variáveis. Campo limpo no painel devolve
# o valor ao ambiente. Com APP_SECRET definido (veja abaixo), a senha digitada no painel fica
# cifrada no banco; sem a chave, ela é gravada em texto puro.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=

# Textos das mensagens enviadas pelos formulários (assunto, corpo e liga/desliga) também são
# editáveis em Painel › Notificações. Os modelos revisados ficam em content/email-templates.json
# e só são usados na primeira instalação; depois disso passam a valer os registros da base.

# Chave que protege segredos gravados pelo painel (hoje a senha do SMTP).
# Gere uma vez por ambiente com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Sem ela, a senha do SMTP fica em texto puro no arquivo do banco e o painel avisa.
# Não troque a chave sem digitar a senha de novo: valores antigos deixam de ser legíveis.
APP_SECRET=

# Limites por IP a cada 15 minutos. Padrões: 6 envios de formulário, 8 tentativas de login.
# Ajuste só se a operação precisar; valores altos enfraquecem a proteção contra abuso.
FORM_RATE_LIMIT=
LOGIN_RATE_LIMIT=

# Retenção: definir com a pessoa responsável por privacidade antes de produção.
# Em NODE_ENV=production, todos os prazos precisam ser números inteiros positivos (dias).
APPLICATION_RETENTION_DAYS=
TALENT_RETENTION_DAYS=
LEAD_RETENTION_DAYS=
PRIVACY_REQUEST_RETENTION_DAYS=
AUDIT_RETENTION_DAYS=
